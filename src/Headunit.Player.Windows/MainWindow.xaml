<Window x:Class="Headunit.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:skin="clr-namespace:Headunit.Skin;assembly=Headunit.Skin"
        Title="Headunit"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B1E"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        KeyDown="OnKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- Everything inside the host is laid out in art pixels: the numbers below
         are the numbers in the sprite atlas, at 1:1. -->
    <skin:ScaledHost x:Name="Host" Scale="2">
        <Grid Width="275" Height="116">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title strip: drag target, and where shade mode will collapse to. -->
            <Border Grid.Row="0"
                    Background="#33333A"
                    BorderBrush="#0F0F11"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="HEADUNIT"
                               Foreground="#B9B9C2"
                               FontFamily="Consolas"
                               FontSize="8"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                    <TextBlock Text="X"
                               Foreground="#B9B9C2"
                               FontFamily="Consolas"
                               FontSize="8"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Cursor="Hand"
                               MouseLeftButtonDown="OnCloseClick" />
                </Grid>
            </Border>

            <!-- Placeholder bezel + LCD. Real sprite atlas lands in M2; the
                 amber here is just the default theme's illumination colour. -->
            <Border Grid.Row="1" Background="#26262A" BorderBrush="#5A5A62" BorderThickness="1">
                <Border Margin="8"
                        Background="#120A00"
                        BorderBrush="#000000"
                        BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="Readout"
                                   Text="M0  SKELETON"
                                   Foreground="#FFA23A"
                                   FontFamily="Consolas"
                                   FontSize="11" />
                        <TextBlock x:Name="ScaleReadout"
                                   Foreground="#7A4A12"
                                   FontFamily="Consolas"
                                   FontSize="8"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </skin:ScaledHost>
</Window>
